{
  "name": "amos-ts",
  "version": "0.9.5",
  "description": "AMOS Professional interpreter and runtime for the web",
  "type": "module",
  "license": "MIT",
  "author": "Gareth Davidson <gaz@bitplane.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitplane/amos-ts.git"
  },
  "bugs": "https://github.com/bitplane/amos-ts/issues",
  "homepage": "https://amos.bitplane.net",
  "keywords": [
    "amos",
    "amos-professional",
    "amiga",
    "basic",
    "interpreter",
    "emulator",
    "retrocomputing",
    "retrogaming"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/amos-ts.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/amos-ts.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:web": "vite build --config vite.web.config.ts && vite build --config vite.lib.config.ts",
    "typecheck": "tsc --noEmit",
    "release": "npm version",
    "preversion": "npm run typecheck && npm run lint && npm test",
    "postversion": "git push --follow-tags",
    "prepublishOnly": "npm run build && npm test",
    "test": "AMOS_COVERAGE_GATE=1 vitest run",
    "test:watch": "vitest",
    "cli": "tsx",
    "manifest": "tsx src/cli/genmanifest.ts",
    "gentables": "tsx src/cli/gentable.ts && tsx src/cli/genext.ts && tsx src/cli/genedmsg.ts && tsx src/cli/genmouse.ts && tsx src/cli/genamoscalls.ts && tsx src/cli/genpiconfig.ts && tsx src/cli/genptrig.ts",
    "gendocs": "tsx src/cli/genmanifest.ts && tsx src/cli/genextdoc.ts",
    "extscan": "tsx src/cli/extscan.ts",
    "contested": "tsx src/cli/contested.ts",
    "libcat": "tsx src/cli/libcat.ts",
    "lint": "oxlint",
    "test:ci": "tsx src/cli/asci.ts",
    "redeploy": "gh workflow run release.yml --ref \"$(git rev-parse --abbrev-ref HEAD)\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "narrator-ts": "^0.2.0",
    "oxlint": "^1.76.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
