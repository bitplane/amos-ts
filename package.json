{
  "name": "amos-ts",
  "version": "0.0.1",
  "description": "AMOS Professional interpreter and runtime for the web",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/amos-ts.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "typecheck": "tsc --noEmit",
    "release": "npm version",
    "preversion": "npm run typecheck && npm test",
    "postversion": "git push --follow-tags",
    "test": "AMOS_COVERAGE_GATE=1 vitest run",
    "test:watch": "vitest",
    "cli": "tsx",
    "manifest": "tsx src/cli/genmanifest.ts",
    "gentables": "tsx src/cli/gentable.ts && tsx src/cli/genext.ts && tsx src/cli/genedmsg.ts && tsx src/cli/genmouse.ts",
    "extscan": "tsx src/cli/extscan.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}